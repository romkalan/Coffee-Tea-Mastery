{
  "name": "coffee-tea-mastery",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run mock-server\" \"vite --open\"",
    "build": "tsc -b && vite build",
    "lint": "eslint src/",
    "preview": "vite preview",
    "deploy": "gh-pages -d build",
    "mock-server": "json-server db.json --port 3000",
    "dev:all": "npm run dev"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.11.2",
    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.5",
    "@types/react-slick": "^0.23.13",
    "@vitejs/plugin-react-swc": "^3.9.0",
    "classnames": "^2.5.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "json-server": "^1.0.0-beta.12",
    "react-router": "^7.6.1",
    "react-router-dom": "7.6.1",
    "sass": "^1.89.1",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  }
